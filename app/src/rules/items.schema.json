{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sortlocal.app/schema/items.schema.json",
  "title": "SortLocal shared item catalog",
  "type": "object",
  "required": ["schemaVersion", "items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "material", "unitMassG", "synonyms"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "enum": ["Paper", "Metal", "Glass", "Plastic", "Organics", "Hygiene", "Hazardous", "Other"] },
          "material": { "type": "string", "enum": ["corrugated", "mixed-paper", "newspaper", "magazines", "office-paper", "aluminum", "steel", "glass", "pet", "hdpe", "pp", "ldpe", "ps", "mixed-plastics", "food-waste", "mixed-organics", "hazardous", "e-waste", "none"] },
          "unitMassG": { "type": "number", "exclusiveMinimum": 0 },
          "synonyms": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
